---
import Layout from "../layouts/Layout.astro";

const ejercicios = [
  {
    titulo: "Introducción a Bases de Datos",
    descripcion: "Apuntes sobre los conceptos fundamentales de bases de datos.",
    archivo: "introduccion-base-datos.pdf",
  },
  {
    titulo: "Modelo Entidad-Relación",
    descripcion:
      "Apuntes sobre entidades, atributos, relaciones y cardinalidades.",
    archivo: "modelo-entidad-relacion.pdf",
  },
  {
    titulo: "Especialización y Generalización",
    descripcion:
      "Apuntes sobre especialización, generalización y el Modelo Entidad-Relación Extendido.",
    archivo: "especializacion-generalizacion.pdf",
  },
  {
    titulo: "Transformación MER a Modelo Relacional",
    descripcion:
      "Apuntes sobre la transformación del Modelo Entidad-Relación al Modelo Relacional.",
    archivo: "transformacion-mer-modelo-relacional.pdf",
  },
  {
    titulo: "Modelo Entidad-Relación",
    descripcion:
      "Ejercicio práctico desarrollado en clase sobre el Modelo Entidad-Relación.",
    archivo: "MER.pdf",
  },
];
---

<Layout>
  <section class="min-h-screen relative py-32 px-6">
    <div class="max-w-6xl mx-auto">
      <!-- Encabezado -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
          Apuntes y ejercicios
        </h1>

        <p class="text-lg text-gray-300">
          Apuntes realizados en clase y ejercicios prácticos para reforzar los
          temas vistos.
        </p>
      </div>

      <!-- Ejercicios -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {
          ejercicios.map((ejercicio) => (
            <div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8">
              <div class="w-16 h-16 rounded-full bg-primary flex items-center justify-center text-2xl text-white mb-6">
                PDF
              </div>

              <h2 class="text-2xl font-bold text-white mb-3">
                {ejercicio.titulo}
              </h2>

              <p class="text-gray-300 mb-8">{ejercicio.descripcion}</p>

              <a
                href="/anamariamoreno11.portafolio/pdfs/ejercicios/MER.pdf"
                target="_blank"
                rel="noopener noreferrer"
                class="block text-center border border-purple-400 rounded-xl py-3 text-purple-300 font-semibold transition-all duration-300 hover:bg-primary hover:text-white"
              >
                Ver PDF
              </a>
            </div>
          ))
        }
      </div>

      <!-- Regresar -->
      <div class="text-center mt-16">
        <a
          href={`${import.meta.env.BASE_URL}#evidencias`}
          class="text-purple-300 font-semibold hover:text-white transition-colors"
        >
          ← Volver a Evidencias
        </a>
      </div>
    </div>
  </section>
</Layout>

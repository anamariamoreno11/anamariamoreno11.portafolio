---
import { PERSONAL_INFO } from "../../data/personal";
---

<header
  id="inicio"
  class="relative min-h-screen flex items-center justify-center px-6 pt-24"
>
  <div
    class="relative z-10 max-w-6xl w-full grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
  >
    <!-- Información -->
    <div data-aos="fade-right">
      <p class="text-purple-300 text-lg font-semibold mb-3">¡Hola! Soy</p>

      <h1 class="text-5xl md:text-7xl font-bold text-white mb-6">
        {PERSONAL_INFO.name}
      </h1>

      <h2 class="text-xl md:text-2xl text-white font-medium mb-6">
        {PERSONAL_INFO.title}
      </h2>

      <p class="text-lg text-gray-300 leading-relaxed mb-4">
        {PERSONAL_INFO.description}
      </p>

      <p class="text-lg text-gray-300 leading-relaxed mb-8">
        Me gusta la música, cantar y ver películas.
      </p>

      <a
        href="#presentacion"
        class="inline-block px-7 py-3 bg-primary hover:bg-secondary text-white font-semibold rounded-3xl transition-all"
      >
        Conóceme
      </a>
    </div>

    <!-- Foto -->
    <div class="flex justify-center" data-aos="fade-left">
      <div
        class="p-6 rounded-3xl bg-white/10 backdrop-blur-md border border-white/20"
      >
        <img
          src="/anamariamoreno11.portafolio/images/anamaria.jpg"
          alt="Foto de Anamaria Moreno"
          class="w-72 h-72 md:w-80 md:h-80 object-cover rounded-full border-4 border-white"
        />
      </div>
    </div>
  </div>
</header>

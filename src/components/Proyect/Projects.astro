---
const evidencias = [
  {
    titulo: "Modelado",
    descripcion:
      "...",
    icono: "◈",
  },
  {
    titulo: "Normalización",
    descripcion:
      "...",
    icono: "✓",
  },
  {
    titulo: "SQL",
    descripcion: "...",
    icono: "⌘",
  },
  {
    titulo: "Proyecto",
    descripcion:
      "...",
    icono: "◇",
  },
];
---

<section id="evidencias" class="relative py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16" data-aos="fade-up">
      <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Evidencias</h2>

      <p class="text-lg text-gray-300">
        Trabajos académicos organizados por categoría
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {
        evidencias.map((evidencia) => (
          <div
            class="bg-white/10 backdrop-blur-md border border-white/20 rounded-3xl p-8 text-center transition-all duration-300 hover:-translate-y-2 hover:bg-white/15"
            data-aos="fade-up"
          >
            <div class="w-20 h-20 mx-auto mb-6 rounded-full bg-primary flex items-center justify-center text-3xl text-white">
              {evidencia.icono}
            </div>

            <h3 class="text-2xl font-bold text-white mb-4">
              {evidencia.titulo}
            </h3>

            <p class="text-gray-300 leading-relaxed mb-8">
              {evidencia.descripcion}
            </p>

            <div class="border border-white/20 rounded-xl py-3 text-gray-400">
              Próximamente
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
